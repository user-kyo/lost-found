generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id            String    @id @default(uuid())
  role          String    // "claimant", "student", "guidance_encoder", "system_admin"
  userType      String?   // "student", "faculty", "staff", "guidance", "admin"
  schoolId      String?   // School ID or Employee ID (e.g., 2023-10492)
  fullName      String
  email         String    @unique
  phone         String?
  passwordHash  String
  status        String    @default("active")
  createdAt     DateTime  @default(now())

  // Relations
  itemsCreated           Item[]              @relation("EncoderItems")
  itemsReviewed          Item[]              @relation("ReviewedItems")
  itemsReceived          Item[]              @relation("ReceivedItems")
  claims                 Claim[]             @relation("ClaimantClaims")
  reviewActions          ReviewAction[]
  searchLogs             SearchLog[]
  releasesGiven          Release[]           @relation("ReleaseOfficer")
  auditLogs              AuditLog[]
  claimVerifications     ClaimVerification[]
  dispositionsApproved   DispositionCase[]   @relation("DispositionApprover")
  dispositionsExecuted   DispositionCase[]   @relation("DispositionExecutor")
  statusHistoryEntries   ItemStatusHistory[]
  documentsUploaded      Document[]

  @@map("users")
}

model Finder {
  id            String    @id @default(uuid())
  name          String
  type          String?   // "student", "faculty", "staff", "visitor", "external"
  schoolId      String?
  contactNumber String?
  email         String?
  department    String?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  items         Item[]

  @@map("finders")
}

model Item {
  id                    String    @id @default(uuid())
  control_no            String?   @unique
  received_at           DateTime? @default(now())
  received_by           String?
  finder_id             String?
  special_handling_type String?   @default("Standard")
  storage_location      String?
  school_holding_end_date DateTime?
  city_publication_date DateTime?
  earliest_award_date   DateTime?
  final_disposition     String?

  encoderId             String    // Guidance personnel who recorded the surrendered item
  category              String
  color                 String
  publicDescription     String
  dateFound             DateTime
  areaFound             String
  imageUrl              String?
  status                String    @default("received") // received, verified, published, claim_pending, released, donated, disposed, turned_over
  reviewedBy            String?
  reviewedAt            DateTime?
  dispositionNote       String?   // Notes when item is disposed/donated
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  encoder               User      @relation("EncoderItems", fields: [encoderId], references: [id])
  reviewer              User?     @relation("ReviewedItems", fields: [reviewedBy], references: [id])
  receiver              User?     @relation("ReceivedItems", fields: [received_by], references: [id])
  finder                Finder?   @relation(fields: [finder_id], references: [id])

  privateDetails        ItemPrivateDetail?
  flags                 ItemFlag[]
  reviewActions         ReviewAction[]
  claims                Claim[]
  releases              Release[]
  dispositionCase       DispositionCase?
  statusHistory         ItemStatusHistory[]
  documents             Document[]

  @@map("items")
}

model ItemPrivateDetail {
  itemId    String   @id
  details   String
  updatedAt DateTime @updatedAt

  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@map("item_private_details")
}

model ItemFlag {
  id              String   @id @default(uuid())
  itemId          String
  type            String   // duplicate, sensitive
  relatedItemId   String?  // If duplicate
  score           Float?   
  detail          String
  resolvedBy      String?
  resolvedAt      DateTime?

  item            Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@map("item_flags")
}

model ReviewAction {
  id          String   @id @default(uuid())
  itemId      String
  adminId     String
  action      String   // approve, edit, merge, reject, dispose
  note        String?
  createdAt   DateTime @default(now())

  item        Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  admin       User     @relation(fields: [adminId], references: [id])

  @@map("review_actions")
}

model SearchLog {
  id          String   @id @default(uuid())
  userId      String
  queryText   String
  resultCount Int
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@map("search_logs")
}

model Claim {
  id            String   @id @default(uuid())
  itemId        String
  claimantId    String
  status        String   @default("submitted") // submitted, under_verification, approved, released, rejected, cancelled
  proofDetails  String?  // Claimant proof details / answers to verification questions
  processedBy   String?  // Guidance Encoder who conducted initial verification
  decidedBy     String?  // Guidance Head who approved/rejected
  decidedAt     DateTime?
  rejectReason  String?
  createdAt     DateTime @default(now())

  item          Item     @relation(fields: [itemId], references: [id])
  claimant      User     @relation("ClaimantClaims", fields: [claimantId], references: [id])
  releases      Release[]
  verifications ClaimVerification[]

  @@index([itemId, status])
  @@map("claims")
}

model Release {
  id                      String    @id @default(uuid())
  claimId                 String
  itemId                  String
  officerId               String    // Guidance personnel who performed the physical release
  claimantName            String    // Recipient name
  claimantSchoolId        String    // Recipient School/Employee ID
  recipientContact        String?
  idTypePresented         String?
  idNumberLast4           String?
  verificationSummary     String
  waiverSigned            Boolean   @default(true)
  acknowledgmentOfReceipt Boolean   @default(true)
  notes                   String?
  releasedAt              DateTime  @default(now())
  createdAt               DateTime  @default(now())

  claim                   Claim     @relation(fields: [claimId], references: [id])
  item                    Item      @relation(fields: [itemId], references: [id])
  officer                 User      @relation("ReleaseOfficer", fields: [officerId], references: [id])
  documents               Document[]

  @@map("releases")
}

model ClaimVerification {
  id                  String    @id @default(uuid())
  claimId             String
  verifiedBy          String
  verificationType    String?   // id_check, physical_match, ownership_proof, interview
  questionsAnswers    String?   // JSON string of verification questions & answers
  idTypePresented     String?
  idNumberLast4       String?
  status              String    @default("pending") // passed, failed, pending
  notes               String?
  verifiedAt          DateTime  @default(now())

  claim               Claim     @relation(fields: [claimId], references: [id], onDelete: Cascade)
  verifier            User      @relation(fields: [verifiedBy], references: [id])

  @@map("claim_verifications")
}

model DispositionCase {
  id                    String    @id @default(uuid())
  itemId                String    @unique
  targetDisposition     String    // donated, disposed, turned_over
  status                String    @default("draft") // draft, pending_approval, approved, executed
  checklistCompleted    Boolean   @default(false)
  checklist             String    // JSON string storing the 5 checklist items
  holdingClockSnapshot  String?   // JSON string of clocks at creation
  approvedBy            String?
  approvedAt            DateTime?
  approvalNotes         String?
  executedBy            String?
  executedAt            DateTime?
  manifestNumber        String?
  recipientOrg          String?
  disposalMethod        String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  item                  Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  approver              User?     @relation("DispositionApprover", fields: [approvedBy], references: [id])
  executor              User?     @relation("DispositionExecutor", fields: [executedBy], references: [id])

  @@map("disposition_cases")
}

model ItemStatusHistory {
  id            String    @id @default(uuid())
  itemId        String
  fromStatus    String?
  toStatus      String
  changedBy     String
  reason        String?
  notes         String?
  createdAt     DateTime  @default(now())

  item          Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  changer       User      @relation(fields: [changedBy], references: [id])

  @@index([itemId, createdAt])
  @@map("item_status_history")
}

model Document {
  id                  String    @id @default(uuid())
  itemId              String?
  claimId             String?
  releaseId           String?
  dispositionCaseId   String?
  documentType        String    // release_waiver, proof_of_ownership, id_scan, disposition_affidavit, intake_receipt
  fileName            String
  fileUrl             String
  fileSize            Int?
  mimeType            String?
  uploadedBy          String
  uploadedAt          DateTime  @default(now())

  item                Item?     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  release             Release?  @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  uploader            User      @relation(fields: [uploadedBy], references: [id])

  @@map("documents")
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String
  action    String
  entity    String
  entityId  String
  metadata  String?  // JSON string
  createdAt DateTime @default(now())

  actor     User     @relation(fields: [actorId], references: [id])

  @@index([actorId, createdAt])
  @@index([entity, entityId])
  @@map("audit_logs")
}

model SystemConfiguration {
  id            String   @id @default("default")
  key           String   @unique
  value         String
  description   String?
  isProvisional Boolean  @default(true)
  updatedBy     String?
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())

  history       ConfigurationHistory[]

  @@map("system_configurations")
}

model ConfigurationHistory {
  id            String   @id @default(uuid())
  configKey     String
  previousValue String?
  newValue      String
  changedBy     String
  note          String?
  createdAt     DateTime @default(now())

  configuration SystemConfiguration @relation(fields: [configKey], references: [key], onDelete: Cascade)

  @@index([configKey, createdAt])
  @@map("configuration_history")
}

